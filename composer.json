{
    "name": "xeno-php/xeno",
    "description": "Xeno is a light-weight, micro framework",
    "keywords": [
        "xeno",
        "micro",
        "framework",
        "light-weight",
        "xenophp",
        "api",
        "rest-api"
    ],
    "type": "project",
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files":[
            "app/Services/Global/Functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "AjayYadavAi",
            "email": "ajayyadavexpo@gmail.com"
        },
        {
            "name": "Sushil Kumar",
            "email": "sushilkumbhar77@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "phpmailer/phpmailer": "^6.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3",
        "phpstan/extension-installer": "^1.4",
        "tomasvotruba/type-coverage": "^2.3",
        "laravel/pint": "^1.30"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist",
        "process-timeout": 0,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "setup": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@composer install --prefer-dist --no-interaction --no-progress",
            "@composer dump-autoload --optimize"
        ],
        "serve": "@php -S localhost:3000 -t public",
        "pint": "pint",
        "pint:test": "pint --test",
        "phpstan": "phpstan analyse",
        "lint": [
            "@pint",
            "@phpstan"
        ],
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-clover coverage.xml"
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
